# ── Laravel's actual "environment-specific config" mechanism ────────────
#
# This is worth being precise about, because it genuinely differs from
# the Spring Boot journey's application-dev.yml / application-prod.yml
# pattern (multiple named profile files, all committed, switched via
# spring.profiles.active). Laravel's default approach is different:
#
#   - For LOCAL vs PRODUCTION vs STAGING: there is normally just ONE file
#     named exactly `.env` per deployment/machine. Your local machine has
#     its own .env with local values; your production server has its own
#     .env with production values. Same filename everywhere, different
#     (gitignored, never-committed) contents per environment. There's no
#     Laravel convention of committing .env.production / .env.staging
#     files the way Spring commits application-prod.yml.
#
#   - The ONE genuine exception is testing: Laravel automatically loads
#     `.env.testing` INSTEAD OF `.env` whenever APP_ENV=testing (which
#     phpunit.xml sets by default for the test suite). This file — copy
#     it to `.env.testing` — exists specifically so your test suite runs
#     against deliberately different values (a separate test database,
#     debug mode forced on, mail forced to a fake/log driver) WITHOUT
#     touching your real local .env at all.
#
# Copy this to `.env.testing` if you want Week 7's test suite to use
# values different from local development.

APP_NAME="Task Manager (Testing)"
APP_ENV=testing
APP_DEBUG=true

# A deliberately different value from the main .env.example, so it's
# obvious from a response which env file was actually loaded.
GREETING_DEFAULT_TONE=formal-testing

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
