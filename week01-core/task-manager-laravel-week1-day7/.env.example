APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=task_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Week 1 Day 4 — grouped config values, read by config/task_manager.php.
# Change GREETING_DEFAULT_TONE here and hit /api/config/demo to see it
# reflected — right up until you run `php artisan config:cache`, after
# which this file stops being read at all. See the README.
GREETING_DEFAULT_TONE=formal
PAGINATION_DEFAULT_SIZE=15
PAGINATION_MAX_SIZE=100
MAINTENANCE_MODE_MESSAGE="We will be back shortly."

# Week 1 Day 7 mini-project — this one ACTUALLY changes which
# GreetingServiceInterface implementation the container hands out by
# default (see GreetingStrategyServiceProvider). One of: formal, casual,
# festive. Contrast with GREETING_DEFAULT_TONE above, which is Day 4's
# purely illustrative value — never consulted by any binding.
GREETING_ACTIVE_STRATEGY=casual
