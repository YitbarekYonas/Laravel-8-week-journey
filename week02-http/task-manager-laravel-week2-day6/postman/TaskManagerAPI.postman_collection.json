                  "pm.test('all() includes the extra field', function () { pm.expect(json.all.extra_field).to.exist; });",
                  "pm.test('only() excludes the extra field', function () { pm.expect(json.only_title_status.extra_field).to.not.exist; });",
                  "pm.test('has_title and filled_title are both true', function () { pm.expect(json.has_title).to.eql(true); pm.expect(json.filled_title).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    }
