    },
    {
      "name": "4. Responses, Status Codes & Headers",
      "item": [
        {
          "name": "Status Code Demo (409)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/status-demo?code=409",
              "host": ["{{base_url}}"],
              "path": ["api", "status-demo"],
              "query": [{ "key": "code", "value": "409" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is genuinely 409, matching the query param', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Header Demo",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Custom-Header", "value": "Postman" }],
            "url": { "raw": "{{base_url}}/api/header-demo", "host": ["{{base_url}}"], "path": ["api", "header-demo"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Echoes the request header sent', function () { pm.expect(json.you_sent_this_header).to.eql('Postman'); });",
                  "pm.test('Sets a custom response header', function () { pm.response.to.have.header('X-Powered-By'); });"
                ]
              }
            }
          ]
