APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Week 3 Day 1 — sqlite by default: zero setup, just a file. This project
# ships an empty database/database.sqlite ready to go — `php artisan
# migrate` will populate it immediately, no separate database server
# needed. DB_DATABASE is deliberately left UNSET here: config/database.php
# falls back to database_path('database.sqlite') (an ABSOLUTE path) when
# it's absent, which is safer than a relative path that could resolve
# differently depending on the working directory `artisan` is invoked
# from. Switch to Postgres by uncommenting the block below instead.
DB_CONNECTION=sqlite

# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=task_manager
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

GREETING_DEFAULT_TONE=formal
PAGINATION_DEFAULT_SIZE=15
PAGINATION_MAX_SIZE=100
MAINTENANCE_MODE_MESSAGE="We will be back shortly."

GREETING_ACTIVE_STRATEGY=casual

# Week 2 Day 4 — the shared-secret gate ApiKeyMiddleware checks against.
# Change this and restart the server to require a different key.
DEMO_API_KEY=demo-secret-key
